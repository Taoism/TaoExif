<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TaoExif.Cli</RootNamespace>
    <AssemblyName>taoexif-cli</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishTrimmed Condition="'$(PublishSingleFile)' == 'true'">true</PublishTrimmed>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaoExif.Core\TaoExif.Core.csproj" />
  </ItemGroup>

  <Import Project="../../build/ExifToolBundle.targets" />

</Project>
